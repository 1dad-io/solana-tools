# The known-validators are operated by Solana Labs

[Unit]
Description=Validator
After=network.target syslog.target
StartLimitIntervalSec=0
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/vote-account-mainnet.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair-mainnet.json

[Service]
Restart=on-failure
RestartSec=1
LimitNOFILE=2000000
LimitMEMLOCK=2000000000
LogRateLimitIntervalSec=0
Environment=SOLANA_METRICS_CONFIG="host=https://metrics.solana.com:8086,db=mainnet-beta,u=mainnet-beta_write,p=password"
Environment=TAG=v3.1.9-jito
