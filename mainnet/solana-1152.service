	--block-engine-url ${BLOCK_ENGINE_URL} \
	--shred-receiver-address ${SHRED_RECEIVER_ADDR} \
	--bam-url ${BAM_URL}
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID

[Install]
WantedBy=multi-user.target
