WorkingDirectory=/home/ubuntu/solana-tools
ExecStart=/home/ubuntu/solana-tools/solana.sh validator \
	--tower /mnt/ramdisk/tower \
	--ledger /mnt/ramdisk/ledger \
	--accounts /mnt/ramdisk/accounts \
	--accounts-index-path /mnt/ramdisk/accounts_index \
	--enable-accounts-disk-index \
	--snapshots /mnt/snap/snapshots \
	--incremental-snapshot-archive-path /mnt/ramdisk/snapshots_inc \
	--log /mnt/data/log/solana.log \
	--identity /home/ubuntu/solana-tools/keys/validator-keypair.json \
	--vote-account /home/ubuntu/solana-tools/keys/vote-account-mainnet.json \
	--authorized-voter /home/ubuntu/solana-tools/keys/validator-keypair-mainnet.json \
	--expected-genesis-hash 5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d \
	--entrypoint entrypoint.mainnet-beta.solana.com:8001 \
	--entrypoint entrypoint2.mainnet-beta.solana.com:8001 \
	--entrypoint entrypoint3.mainnet-beta.solana.com:8001 \
	--entrypoint entrypoint4.mainnet-beta.solana.com:8001 \
	--entrypoint entrypoint5.mainnet-beta.solana.com:8001 \
	--known-validator 7Np41oeYqPefeNQEHSv1UDhYrehxin3NStELsSKCT4K2 \
	--known-validator GdnSyH3YtwcxFvQrVVJMm1JhTS4QVX7MFsX56uJLUfiZ \
	--known-validator DE1bawNcRJB9rVm3buyMVfr8mBEoyyu73NBovf2oXJsJ \
	--known-validator CakcnaRDHka2gXyfbEd2d3xsvkJkqsLw2akB3zsN1D2S \
	--dynamic-port-range 8000-8025 \
	--rpc-port 8899 \
	--full-rpc-api \
	--only-known-rpc \
	--private-rpc \
	--snapshot-interval-slots 100 \
	--full-snapshot-interval-slots 100000 \
	--maximum-full-snapshots-to-retain 2 \
	--maximum-incremental-snapshots-to-retain 2 \
	--maximum-local-snapshot-age 2500 \
	--minimal-snapshot-download-speed 52428800 \
	--wal-recovery-mode skip_any_corrupted_record \
	--limit-ledger-size 50000000 \
	--no-poh-speed-test \
	--no-port-check \
	--tip-payment-program-pubkey T1pyyaTNZsKv2WcRAB8oVnk93mLJw2XzjtVYqCsaHqt \
	--tip-distribution-program-pubkey 4R3gSG8BpU4t19KYj8CfnbtRpnT8gtk4dvTHxVRwc2r7 \
