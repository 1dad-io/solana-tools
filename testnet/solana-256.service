Environment="BLOCK_ENGINE_URL=https://dallas.testnet.block-engine.jito.wtf"
Environment="SHRED_RECEIVER_ADDR=141.98.218.12:1002"
Environment="BAM_URL=http://dallas.testnet.bam.jito.wtf"
