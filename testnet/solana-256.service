[Unit]
Description=Validator
After=network.target syslog.target
StartLimitIntervalSec=0
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/vote-account-testnet.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair-testnet.json

[Service]
Restart=on-failure
RestartSec=1
LimitNOFILE=1000000
LimitMEMLOCK=2000000000
LogRateLimitIntervalSec=0
Environment=SOLANA_METRICS_CONFIG="host=https://metrics.solana.com:8086,db=tds,u=testnet_write,p=c4fa841aa918bf8274e3e2a44d77568d9861b3ea"
