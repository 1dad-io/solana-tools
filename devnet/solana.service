# The known-validators are operated by Solana Labs

[Unit]
Description=Validator
After=network.target syslog.target
StartLimitIntervalSec=0
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/vote-account-devnet.json
ConditionPathExists=/home/ubuntu/solana-tools/keys/validator-keypair-devnet.json

[Service]
Restart=on-failure
RestartSec=1
LimitNOFILE=1000000
LimitMEMLOCK=2000000000
LogRateLimitIntervalSec=0
Environment=SOLANA_METRICS_CONFIG="host=https://metrics.solana.com:8086,db=devnet,u=scratch_writer,p=topsecret"
WorkingDirectory=/home/ubuntu/solana-tools
ExecStart=/home/ubuntu/solana-tools/solana.sh validator \
	--ledger /mnt/data/ledger \
	--accounts /mnt/acct/accounts \
	--accounts-index-path /mnt/acct/accounts_index \
	--snapshots /mnt/snap/snapshots \
	--incremental-snapshot-archive-path /mnt/snap/snapshots_inc \
	--log /mnt/data/log/solana.log \
	--identity /home/ubuntu/solana-tools/keys/validator-keypair.json \
	--vote-account /home/ubuntu/solana-tools/keys/vote-account-devnet.json \
	--authorized-voter /home/ubuntu/solana-tools/keys/validator-keypair-devnet.json \
	--expected-genesis-hash EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG \
	--entrypoint entrypoint.devnet.solana.com:8001 \
	--entrypoint entrypoint2.devnet.solana.com:8001 \
	--entrypoint entrypoint3.devnet.solana.com:8001 \
	--entrypoint entrypoint4.devnet.solana.com:8001 \
	--entrypoint entrypoint5.devnet.solana.com:8001 \
	--known-validator dv1ZAGvdsz5hHLwWXsVnM94hWf1pjbKVau1QVkaMJ92 \
	--known-validator dv2eQHeP4RFrJZ6UeiZWoc3XTtmtZCUKxxCApCDcRNV \
	--known-validator dv4ACNkpYPcE3aKmYDqZm9G5EB3J4MRoeE7WNDRBVJB \
	--known-validator dv3qDFk1DTF36Z62bNvrCXe9sKATA6xvVy6A798xxAS \
	--dynamic-port-range 8000-8025 \
	--rpc-bind-address 0.0.0.0 \
	--rpc-port 8899 \
	--full-rpc-api \
	--only-known-rpc \
	--private-rpc \
	--snapshot-interval-slots 100 \
	--full-snapshot-interval-slots 100000 \
	--maximum-full-snapshots-to-retain 2 \
	--maximum-incremental-snapshots-to-retain 4 \
	--maximum-local-snapshot-age 2500 \
	--minimal-snapshot-download-speed 52428800 \
	--wal-recovery-mode skip_any_corrupted_record \
	--limit-ledger-size 50000000 \
	--enable-accounts-disk-index \
	--no-poh-speed-test \
	--no-port-check
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID

[Install]
WantedBy=multi-user.target
